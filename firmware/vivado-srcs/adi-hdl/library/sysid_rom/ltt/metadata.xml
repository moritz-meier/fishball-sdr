<lsccip:ip xmlns:lsccip="http://www.latticesemi.com/XMLSchema/Radiant/ip"
    xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <lsccip:general>
        <lsccip:vendor>analog.com</lsccip:vendor>
        <lsccip:library>ip</lsccip:library>
        <lsccip:name>sysid_rom</lsccip:name>
        <lsccip:display_name>sysid_rom</lsccip:display_name>
        <lsccip:version>1.0</lsccip:version>
        <lsccip:category>CUSTOM_IP</lsccip:category>
        <lsccip:keywords>sysid_rom</lsccip:keywords>
        <lsccip:min_radiant_version>2023.2</lsccip:min_radiant_version>
        <lsccip:min_esi_version>2023.2</lsccip:min_esi_version>
        <lsccip:supported_products>
            <lsccip:supported_family name="*"/>
        </lsccip:supported_products>
        <lsccip:supported_platforms>
            <lsccip:supported_platform name="esi"/>
            <lsccip:supported_platform name="radiant"/>
        </lsccip:supported_platforms>
    </lsccip:general>
    <lsccip:settings>
        <lsccip:setting id="ROM_WIDTH"
                        type="param"
                        value_type="int"
                        conn_mod="sysid_rom"
                        title="ROM_WIDTH"
                        default="32"
                        output_formatter="nostr"
                        group1="PARAMS"
                        group2="GLOB"
                       />
        <lsccip:setting id="ROM_ADDR_BITS"
                        type="param"
                        value_type="int"
                        conn_mod="sysid_rom"
                        title="ROM_ADDR_BITS"
                        default="6"
                        output_formatter="nostr"
                        group1="PARAMS"
                        group2="GLOB"
                       />
        <lsccip:setting id="PATH_TO_FILE"
                        type="param"
                        value_type="string"
                        conn_mod="sysid_rom"
                        title="PATH_TO_FILE"
                        default="sysid_init_file.mem"
                        output_formatter="str"
                        group1="PARAMS"
                        group2="GLOB"
                        description="PATH_TO_FILE"
                       />
    </lsccip:settings>
    <lsccip:ports>
        <lsccip:port name="clk"
                     dir="in"
                     conn_mod="sysid_rom"
                     conn_port="clk"
                    />
        <lsccip:port name="rom_addr"
                     dir="in"
                     conn_mod="sysid_rom"
                     range="(int(ROM_ADDR_BITS-1),0)"
                     conn_port="rom_addr"
                    />
        <lsccip:port name="rom_data"
                     dir="out"
                     conn_mod="sysid_rom"
                     range="(int(ROM_WIDTH-1),0)"
                     conn_port="rom_data"
                    />
    </lsccip:ports>
</lsccip:ip>

