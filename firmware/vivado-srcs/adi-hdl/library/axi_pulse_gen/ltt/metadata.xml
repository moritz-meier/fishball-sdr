<lsccip:ip xmlns:lsccip="http://www.latticesemi.com/XMLSchema/Radiant/ip"
    xmlns:xi="http://www.w3.org/2001/XInclude" version="1.0">
    <lsccip:general>
        <lsccip:vendor>analog.com</lsccip:vendor>
        <lsccip:library>ip</lsccip:library>
        <lsccip:name>axi_pulse_gen</lsccip:name>
        <lsccip:display_name>ADI AXI Pulse generator</lsccip:display_name>
        <lsccip:version>1.0</lsccip:version>
        <lsccip:category>ADI</lsccip:category>
        <lsccip:keywords>ADI IP</lsccip:keywords>
        <lsccip:min_radiant_version>2023.2</lsccip:min_radiant_version>
        <lsccip:min_esi_version>2023.2</lsccip:min_esi_version>
        <lsccip:supported_products>
            <lsccip:supported_family name="*"/>
        </lsccip:supported_products>
        <lsccip:supported_platforms>
            <lsccip:supported_platform name="esi"/>
            <lsccip:supported_platform name="radiant"/>
        </lsccip:supported_platforms>
    </lsccip:general>
    <lsccip:settings>
        <lsccip:setting id="ASYNC_CLK_EN"
                        type="param"
                        value_type="int"
                        conn_mod="axi_pulse_gen"
                        title="ASYNC_CLK_EN"
                        default="1"
                        options="[(True, 1), (False, 0)]"
                        output_formatter="nostr"
                        group1="AXI Pulse Generator"
                        group2="Config"
                       />
        <lsccip:setting id="PULSE_WIDTH"
                        type="param"
                        value_type="int"
                        conn_mod="axi_pulse_gen"
                        title="Pulse width"
                        default="7"
                        output_formatter="nostr"
                        value_range="(0, 2147483647)"
                        group1="AXI Pulse Generator"
                        group2="Config"
                       />
        <lsccip:setting id="PULSE_PERIOD"
                        type="param"
                        value_type="int"
                        conn_mod="axi_pulse_gen"
                        title="Pulse period"
                        default="10"
                        output_formatter="nostr"
                        value_range="(0, 2147483647)"
                        group1="AXI Pulse Generator"
                        group2="Config"
                       />
    </lsccip:settings>
    <lsccip:ports>
        <lsccip:port name="s_axi_aclk"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_aclk"
                    />
        <lsccip:port name="s_axi_aresetn"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_aresetn"
                    />
        <lsccip:port name="s_axi_awvalid"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_awvalid"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_awaddr"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     range="(int(15),0)"
                     conn_port="s_axi_awaddr"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_awprot"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     range="(int(2),0)"
                     conn_port="s_axi_awprot"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_awready"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_awready"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_wvalid"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_wvalid"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_wdata"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     range="(int(31),0)"
                     conn_port="s_axi_wdata"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_wstrb"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     range="(int(3),0)"
                     conn_port="s_axi_wstrb"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_wready"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_wready"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_bvalid"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_bvalid"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_bresp"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     range="(int(1),0)"
                     conn_port="s_axi_bresp"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_bready"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_bready"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_arvalid"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_arvalid"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_araddr"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     range="(int(15),0)"
                     conn_port="s_axi_araddr"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_arprot"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     range="(int(2),0)"
                     conn_port="s_axi_arprot"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_arready"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_arready"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_rvalid"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_rvalid"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_rresp"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     range="(int(1),0)"
                     conn_port="s_axi_rresp"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_rdata"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     range="(int(31),0)"
                     conn_port="s_axi_rdata"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="s_axi_rready"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="s_axi_rready"
                     bus_interface="s_axi"
                    />
        <lsccip:port name="ext_clk"
                     dir="in"
                     conn_mod="axi_pulse_gen"
                     conn_port="ext_clk"
                     dangling="(ASYNC_CLK_EN == 0)"
                    />
        <lsccip:port name="pulse"
                     dir="out"
                     conn_mod="axi_pulse_gen"
                     conn_port="pulse"
                    />
    </lsccip:ports>
    <xi:include href="bus_interface.xml" parse="xml"/>
    <xi:include href="memory_map.xml" parse="xml"/>
</lsccip:ip>

